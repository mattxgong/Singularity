{
  "name": "singularity",
  "version": "2.4.0",
  "private": true,
  "scripts": {
    "start": "next dev",
    "dev": "next dev",
    "build": "next build && node ./scripts/postbuild.mjs",
    "content:build": "node --input-type=module -e \"import('@content-collections/core').then(async ({ createBuilder }) => { const builder = await createBuilder('content-collections.ts'); await builder.build() })\"",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:headed": "playwright test --headed",
    "test:a11y": "cross-env PLAYWRIGHT_SUITE=a11y playwright test",
    "test:visual": "cross-env PLAYWRIGHT_SUITE=visual playwright test",
    "test:visual:update": "cross-env PLAYWRIGHT_SUITE=visual playwright test --update-snapshots",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "lighthouse": "lhci autorun",
    "lint": "eslint app components layouts lib scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:client-boundary": "node scripts/check-client-boundary.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:sensitive": "python scripts/check-sensitive-data.py public/resume/matthew-gong-resume.pdf",
    "prepare": "husky"
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@headlessui/react": "2.2.9",
    "@next/bundle-analyzer": "15.5.12",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/speed-insights": "^2.0.0",
    "body-scroll-lock": "^3.1.5",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "entities": "^8.1.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "image-size": "2.0.2",
    "minisearch": "^7.2.0",
    "next": "15.5.12",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.2",
    "rehype-katex": "^7.0.1",
    "rehype-katex-notranslate": "^1.1.4",
    "rehype-preset-minify": "7.0.1",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@content-collections/core": "0.15.2",
    "@content-collections/mdx": "0.2.2",
    "@content-collections/next": "0.2.11",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.18.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/body-scroll-lock": "^3.1.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.20.3",
    "@types/react": "^19.2.13",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cheerio": "^1.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rehype-pretty-code": "0.14.5",
    "shiki": "4.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "zod": "4.1.11"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "yarn eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "yarn prettier --write"
    ]
  },
  "packageManager": "yarn@3.6.1"
}
